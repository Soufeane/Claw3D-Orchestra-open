# Required before login. Keep real values in your shell or secret manager, never in Git.
CLAW3D_ADMIN_PASSWORD=
CLAW3D_DB_PATH=data/claw3d.sqlite3
CLAW3D_HOST=127.0.0.1
CLAW3D_PORT=8000
CLAW3D_COOKIE_SECURE=0

